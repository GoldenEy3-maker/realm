{
  "name": "@realm/web",
  "private": true,
  "type": "module",
  "imports": {
    "@/*": "./src/*"
  },
  "scripts": {
    "openapi:generate": "bun run openapi-generator.ts",
    "predev": "bun run openapi:generate && bun run i18n-typograf && bun run css-types",
    "dev": "concurrently --kill-others \"bun run css-types:watch\" \"vite dev --port 5173\"",
    "generate-routes": "tsr generate",
    "prebuild": "bun run openapi:generate && bun run i18n-typograf && bun run css-types",
    "build": "vite build",
    "start": "vite preview",
    "lint": "eslint",
    "format": "prettier --write . && eslint --fix",
    "check": "prettier --check .",
    "machine-translate": "inlang machine translate --project project.inlang",
    "stylelint": "stylelint 'src/**/*.scss'",
    "stylelint:fix": "stylelint 'src/**/*.scss' --fix",
    "i18n-typograf": "bun scripts/i18n-typograf.ts",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "css-types": "hcm 'src/**/*.module.scss' --sassLoadPaths src/app/styles",
    "css-types:watch": "hcm 'src/**/*.module.scss' --sassLoadPaths src/app/styles --watch"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@gravity-ui/icons": "^2.22.0",
    "@tanstack/react-devtools": "latest",
    "@tanstack/react-query": "^5.102.8",
    "@tanstack/react-router": "latest",
    "@tanstack/react-router-devtools": "latest",
    "classnames": "^2.5.1",
    "globals": "^17.12.0",
    "less": "^4.9.1",
    "lucide-react": "^1.42.0",
    "openapi-typescript": "^7.13.0",
    "react": "^19.2.0",
    "react-aria-components": "^1.21.0",
    "react-dom": "^19.2.0",
    "sass": "^1.103.1",
    "stylelint-use-logical": "^2.1.3",
    "typograf": "^7.8.0"
  },
  "devDependencies": {
    "@repo/prettier": "workspace:*",
    "@inlang/cli": "^3.0.0",
    "@inlang/paraglide-js": "^2.25.0",
    "@storybook/addon-a11y": "^10.6.0",
    "@storybook/addon-docs": "^10.6.0",
    "@storybook/react-vite": "^10.6.0",
    "@tanstack/devtools-vite": "latest",
    "@tanstack/eslint-config": "latest",
    "@tanstack/eslint-plugin-query": "^5.102.8",
    "@tanstack/eslint-plugin-router": "^1.162.0",
    "@tanstack/react-query-devtools": "^5.102.8",
    "@tanstack/router-cli": "^1.132.0",
    "@tanstack/router-plugin": "latest",
    "@total-typescript/ts-reset": "^0.6.1",
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.1",
    "@zhoumutou/postcss-wrap-layer": "^0.1.2",
    "concurrently": "^10.0.5",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-boundaries": "^7.2.0",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "happy-css-modules": "^5.0.2",
    "postcss": "^8.5.27",
    "postcss-load-config": "^6.0.1",
    "postcss-pxtorem": "^6.1.0",
    "postcss-resolve-nested-selector": "^0.1.6",
    "postcss-selector-parser": "^7.1.6",
    "prettier": "^3.9.6",
    "storybook": "^10.6.0",
    "stylelint": "^17.14.1",
    "stylelint-config-clean-order": "^10.0.0",
    "stylelint-config-css-modules": "^4.6.0",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "lightningcss"
    ]
  }
}
